{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "kachick's Renovate configuration for npm",
  "npm": {
    "enabled": true
  },
  "rangeStrategy": "bump",
  "extends": [
    "schedule:monthly"
  ],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": []
  }
}
