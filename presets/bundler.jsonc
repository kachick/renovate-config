{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "kachick's Renovate configuration for Ruby / Bundler",
  "bundler": {
    "enabled": true
  },
  // Use rangeStrategy "bump" (equivalent to Dependabot's versioning-strategy: increase) to update Gemfile/gemspec constraints.
  "rangeStrategy": "bump",
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": []
  },
  "packageRules": [
    {
      "description": "Disable Ruby version bumps since toolchains are managed via Nix",
      "matchManagers": [
        "bundler"
      ],
      "matchDatasources": [
        "ruby-version"
      ],
      "enabled": false
    }
  ]
}
