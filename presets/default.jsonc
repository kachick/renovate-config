{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "kachick's default Renovate configuration",
  "dependencyDashboard": true,
  // Include GitHub Actions and dprint by default to minimize API requests and maintenance across all repositories.
  "extends": [
    ":semanticCommitsDisabled",
    "helpers:pinGitHubActionDigests",
    "github>kachick/renovate-config-dprint"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "dockerfile": {
    "enabled": true
  },
  "docker-compose": {
    "enabled": true
  },
  "nix": {
    "enabled": false
  },
  // Keep language-specific managers disabled by default so they are only enabled via dedicated presets.
  "bundler": {
    "enabled": false
  },
  "cargo": {
    "enabled": false
  },
  "gomod": {
    "enabled": false
  },
  "npm": {
    "enabled": false
  },
  "prConcurrentLimit": 1,
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": []
  },
  "packageRules": [
    // Pinning unpinned references improves security immediately, so do not delay them with cooldown periods.
    {
      "description": "Disable minimumReleaseAge for pinDigest updates",
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "minimumReleaseAge": null
    },
    // Keep kachick actions unpinned so repositories can track branches like main for quick updates.
    {
      "description": "Do not pin digests for kachick's GitHub Actions and reusable workflows",
      "matchDepTypes": [
        "action",
        "workflow"
      ],
      "matchPackageNames": [
        "kachick/**"
      ],
      "pinDigests": false
    },
    // dprint plugins update frequently and formatters are low risk, so schedule monthly to reduce PR noise.
    {
      "description": "Group dprint plugin updates into a single PR when 2 or more updates are available, scheduled monthly",
      "matchManagers": [
        "custom.regex"
      ],
      "extends": [
        "schedule:monthly"
      ],
      "groupName": "dprint plugins",
      "minimumGroupSize": 2
    }
  ]
}
