{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "kachick's Renovate configuration for Go modules",
  "gomod": {
    "enabled": true,
    "postUpdateOptions": [
      "gomodTidy"
    ]
  },
  "extends": [
    "schedule:monthly"
  ],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": []
  },
  "packageRules": [
    {
      "description": "Disable Go version bumps in go.mod since toolchains are managed via Nix",
      "matchManagers": [
        "gomod"
      ],
      "matchDatasources": [
        "golang-version"
      ],
      "enabled": false
    }
  ]
}
